{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Intelligence Workspace",
  "version": "0.1.0",
  "identifier": "dev.meetingintelligence.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Intelligence Workspace",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "recording-widget",
        "title": "Meeting Intelligence \u00b7 Recording",
        "url": "index.html?widget=recording",
        "width": 340,
        "height": 240,
        "minWidth": 280,
        "minHeight": 140,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' http://recording.localhost recording:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
