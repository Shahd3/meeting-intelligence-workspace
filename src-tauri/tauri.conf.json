{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Intelligence Workspace",
  "version": "0.1.0",
  "identifier": "dev.meetingintelligence.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Meeting Intelligence Workspace",
      "width": 1100,
      "height": 760,
      "minWidth": 640,
      "minHeight": 480
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
